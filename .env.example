# Data Source Configuration
# Configure external URL for BH-dados-publicos.json to decouple data from application
# Leave empty to use local file from public folder (development mode)

# Example: VITE_DATA_SOURCE_URL=https://cdn.example.com/data/BH-dados-publicos.json
VITE_DATA_SOURCE_URL=

# Force using external source even if local file exists
VITE_FORCE_EXTERNAL_SOURCE=false
